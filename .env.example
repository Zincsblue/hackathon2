# Task API Backend Environment Configuration
# Copy this file to .env and fill in the values

# Database Configuration (Neon Serverless PostgreSQL)
DATABASE_URL=postgresql://username:password@ep-xxx.region.neon.tech/database?sslmode=require

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Debug Mode (true/false)
DEBUG=false

# Logging Level (debug, info, warning, error, critical)
LOG_LEVEL=info

# Authentication Configuration (NEW)
SECRET_KEY=your-secret-key-here-generate-with-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Rate Limiting (NEW)
REDIS_URL=redis://localhost:6379
